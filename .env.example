# Copy to .env.local for local work. In CI these come from GitHub repository
# Variables (Settings > Secrets and variables > Actions > Variables). None are secret:
# everything prefixed VITE_ is shipped to the browser.

VITE_SITE_NAME=Susa
# Canonical public URL, no trailing slash. Drives canonical tags, sitemap, OG, JSON-LD.
VITE_SITE_URL=https://www.example.co.za
# "/" for a custom domain, "/<repo-name>/" for github.io project pages.
VITE_BASE=/
# International format, digits only (e.g. 27821234567). Leave empty to hide WhatsApp.
VITE_WHATSAPP_NUMBER=
VITE_PHONE=
VITE_CONTACT_EMAIL=
# Quote-request API (the orchestrator gateway). Empty = form falls back to WhatsApp/email.
VITE_API_BASE_URL=
VITE_VAT_REGISTERED=false
# Optional: Search Console verification token (content of the meta tag).
VITE_GSC_VERIFICATION=
